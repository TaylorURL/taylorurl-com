# Server-side variables the deployed functions read. Values are set per
# environment in Vercel; this file names them and carries none of them.

# Where api/status-feed.js reads the uptime monitor's JSON from.
STATUS_FEED_URL=

# Where api/analytics.js forwards the console's signed-in reads to.
ANALYTICS_SUMMARY_URL=

# Where api/console-admin.js forwards the admin console's writes to, and where
# api/site-speed.js reads a site's PageSpeed figures from. Both name the
# project's own edge function by default, so each is an override for a function
# that has moved rather than a value a deployment has to carry.
CONSOLE_ADMIN_URL=
SITE_SPEED_URL=

# The Supabase project the serverless functions reach. The URL has a default in
# each file. The anon key is what a caller's session is verified against; the
# service role key bypasses row-level security, reaches the tables no other key
# can, and never leaves the function. Without the service role key the endpoints
# that need it answer 503 rather than reporting work they did not do.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The Resend key every outbound message is sent with: enquiries from
# api/contact.js, list confirmations from the collect-email function, and
# issues from api/newsletter-send.js.
RESEND_API_KEY=

# Where api/contact.js delivers enquiries.
CONTACT_INBOX=

# The From line every newsletter issue carries, and where its one-click
# unsubscribe header points.
NEWSLETTER_FROM=
NEWSLETTER_UNSUBSCRIBE_URL=

# Origin the read-on-the-web links in an issue are built from.
SITE_URL=

# Which site this build is: taylorurl or taylorwebsite. One tree builds both
# deployments and this is what tells them apart - the copy, the canonical
# origin, the structured data, and which one answers the crons. Leaving it
# unset builds taylorurl, which is what every build did before the second site
# existed. A value naming no site stops the build rather than falling back,
# because a fallback publishes one site's copy on the other's domain and the
# output looks correct either way.
#
# Not the same variable as SITE_URL above, which is a runtime origin override
# that six api handlers read. The names are one character apart and they do
# different jobs.
SITE=

# The secret Vercel signs a scheduled invocation with. Every endpoint under
# api/outreach refuses a caller carrying neither this secret nor an admin
# console session, and api/newsletter-due.js takes the secret alone. Leaving it
# unset locks the schedule out along with everybody else, and no issue goes out
# on the date it was given.
CRON_SECRET=

# What api/speed-check.js peppers a caller's address with before it stores a
# digest of one. Counting checks per connection has to tell two callers apart
# and needs nothing else about either, and a bare digest of an IPv4 address is a
# lookup table away from the address itself. It falls back to CRON_SECRET, which
# every deployment running the outreach schedule already carries; with neither
# set the row stores no connection and the per-caller ceilings fall back to the
# window one function instance holds.
SPEED_CHECK_PEPPER=

# The Google keys the outreach jobs work through. Places (New) is what
# api/outreach/source.js searches each town and trade with; PageSpeed Insights
# is what api/outreach/audit.js scores each prospect's website with and what
# api/speed-check.js measures a visitor's own address with, and the score it
# returns is the figure both the outreach message and the page quote.
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# The Workspace mailbox api/outreach/send.js sends from and api/outreach/watch.js
# reads replies and bounces out of. One account reached two ways: the host and
# port default to Google's on both sides, and the mailbox defaults to INBOX.
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASSWORD=
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=
OUTREACH_IMAP_MAILBOX=

# The second of the two switches on outreach sending, alongside sending_enabled
# in outreach_settings. Only the exact word true opens it, both are off unless
# set, and while either is off api/outreach/send.js writes the message as a
# draft and reaches no mail server.
OUTREACH_SEND_ARMED=

# The phone number every outreach message signs off with. Leaving it blank does
# not drop the line: the studio's own number stands in, because a message that
# reaches a stranger with no way to reach a person back is the one message this
# pipeline must not send. Set it only to publish a different number.
OUTREACH_REPLY_PHONE=

# The origin every link, the open counter and the unsubscribe URL in a delivered
# outreach message point at. It defaults to the domain outreach sends from
# rather than to the request's own, because a preview deployment goes away and a
# link already in somebody's inbox does not.
OUTREACH_SITE_URL=

# What Resend reports back about a newsletter after it leaves: delivery, opens,
# clicks, bounces and complaints, on a webhook to api/newsletter-events.js.
# Either credential admits an event and neither is optional in the sense that a
# request carrying neither is refused. The shared secret rides on the webhook
# URL as ?key=...; the signing secret is the whsec_ value Resend shows when the
# endpoint is created, and signs the exact bytes of the body.
NEWSLETTER_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=

# The Buffer token a queued social update is posted with. api/social-queue.js
# reads it here and answers 500 without it; scripts/social.js prefers the copy
# in CryptoFort and falls back to this one.
BUFFER_API_KEY=

# What opens CryptoFort for scripts/social.js when it has no BUFFER_API_KEY of
# its own. The master key is read alongside SUPABASE_SERVICE_ROLE_KEY and the
# key id names which key inside the vault, defaulting to default. Neither is
# set on a deployment: the vault is reached from a machine, not from a
# function.
CRYPTOFORT_MASTER_KEY=
CRYPTOFORT_KEY_ID=

# What api/checkout.js opens a checkout with. This one writes - it creates the
# session that charges a card - so it is a deployment secret and a different
# key from the read-only one above, kept separate so a key that can only list
# customers cannot be mistaken for one that can take money.
STRIPE_SECRET_KEY=

# What api/payments-admin.js reads the account with, for the console's Payments
# section. This one only ever lists - customers, subscriptions, invoices and
# charges - so it is a restricted read-only key rather than the one above, kept
# apart so a section that shows money is not holding a key that could take any.
# Unset, the section falls back to STRIPE_SECRET_KEY, which reads the same four
# collections; setting it is what stops a reporting page carrying a key that can
# charge a card.
STRIPE_READONLY_KEY=

# The two products the checkout's lines belong to: the build, paid once, and
# the care, charged monthly from the same day. The amounts live in
# src/app/data/pricing.js and travel with each request; these name only what
# the amounts are for, so a subscription sits under one product in the account
# rather than under a product minted per checkout. A product id belongs to one
# mode of the account, so the live pair goes on Production and a sandbox, if
# one is ever used, needs its own pair. Without both, api/checkout.js answers
# 503 and names the missing one in the log.
STRIPE_PRODUCT_BUILD=
STRIPE_PRODUCT_CARE=

# The number a client with a build in progress is told to ring, shown under
# every update on their tracker. Served rather than compiled in, because this
# repository is public and the site publishes no phone number anywhere. Unset,
# the tracker offers the support address instead.
SUPPORT_PHONE=

# What api/stripe-webhook.js checks a delivery against. Stripe issues one per
# endpoint, and it is the whole security of the door that opens paid projects:
# without it every delivery is refused, and with the wrong one every delivery
# is refused quietly.
STRIPE_WEBHOOK_SECRET=

# What api/stripe-webhook.js reports a completed sale to the ad accounts with.
#
# Everything a browser can report about a build stops at the checkout being
# opened, because the browser is gone before the money settles. Without these
# the accounts are bidding on that reading alone, which counts the buyers who
# reached Stripe and closed the tab alongside the ones who paid. With them, the
# one delivery that opens a project uploads the sale to each account against the
# click identifier the checkout wrote onto the Stripe session.
#
# Meta takes one long-lived token, generated against the pixel in Events
# Manager. The pixel id is not here: it belongs to the site rather than to the
# deployment and lives in lib/site/registry.js beside the ad account.
META_CAPI_ACCESS_TOKEN=

# Google wants six. The developer token belongs to the manager account and is
# what admits the API call at all; the customer id is the ten-digit account
# number with the dashes taken out, and is a different number from the AW- id
# the tag block uses. The purchase action is the numeric id of a conversion
# action created in that account for a website sale, which the account mints
# and which cannot be derived from anything. The last three are an OAuth client
# and a refresh token generated against it once, offline, since a function has
# nobody to ask for consent. Any one of them unset reports nothing to Google and
# leaves Meta alone.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_PURCHASE_ACTION_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# One more is optional: the manager account's own number, on the same terms as
# the customer id. It is wanted wherever the ad account is administered from a
# manager rather than held outright by the user the refresh token was minted
# for. Left out where it is needed, the upload is refused as an account that is
# not there, which reads the same as a sale the account declined.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Where api/live-chat.js reaches the assistant that answers the chat widget. It
# runs off-platform, because a serverless function cannot hold a thread across
# turns. Unset, every turn answers with the offline message.
LIVE_AGENT_URL=

# The bearer secret that door is opened with; without it every turn answers a
# visitor with the offline message instead of spending anything.
LIVE_AGENT_SECRET=

# Peppers the caller digest the chat's hourly and daily ceilings are counted
# over. Falls back to SPEED_CHECK_PEPPER and then CRON_SECRET; with none of the
# three set, no connection is recorded and only the per-thread ceiling holds.
LIVE_CHAT_PEPPER=

# The address a client project's notifications leave from where its own row
# names none. api/notify.js sends on behalf of the products the studio runs, and
# the domain in front of it has to be one Resend has verified against the
# account, which is this one until a client verifies theirs. The project's name
# rides in the display name either way, so a reader sees the client and not the
# studio. Unset, it falls back to notifications@taylorurl.com.
#
# There is no variable here for the projects themselves. Each one authenticates
# with its own bearer secret, and what this deployment holds is the sha256 of
# that secret in notify_projects - so the credential a client's deployment sends
# with exists nowhere on this side, and adding a project is a row rather than a
# release.
NOTIFY_FROM_ADDRESS=
