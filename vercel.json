{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/outreach/source",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/outreach/enrich",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/outreach/audit",
      "schedule": "10,40 * * * *"
    },
    {
      "path": "/api/outreach/ramp",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/outreach/send",
      "schedule": "*/10 13-23 * * *"
    },
    {
      "path": "/api/outreach/watch",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/social-queue",
      "schedule": "20 15 * * *"
    },
    {
      "path": "/api/social-watch",
      "schedule": "40 17 * * *"
    },
    {
      "path": "/api/start-followup",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
